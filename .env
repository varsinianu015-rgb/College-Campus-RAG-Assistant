# OpenAI key is used ONLY for GPT-4o mini answer generation. Keep secret; never commit .env.
OPENAI_API_KEY="OPENAPIKEY"

# LLM for answer generation (unchanged)
OPENAI_CHAT_MODEL=gpt-4o-mini

# Free local Hugging Face embedding model (downloads on first run)
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# New Chroma index: do not mix with previous Gemini/OpenAI embedding indexes
CHROMA_PERSIST_DIRECTORY=./data/chroma_gpt4o_local_embeddings
UPLOAD_DIRECTORY=./data/uploads

# Retrieval configuration
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_K=4
MIN_RELEVANCE_SCORE=0.05
MAX_UPLOAD_MB=20
